# --- database ---
# postgres://... (docker compose up -d gives you one on :5433) or the embedded PGlite.
DATABASE_URL=pglite://./.pglite

# --- privy (auth + wallets) https://dashboard.privy.io ---
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Base64 PKCS8 authorization private key (no PEM headers) that owns agent server wallets.
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# --- secrets ---
# 32 bytes base64 — `openssl rand -base64 32`. Encrypts user LLM keys at rest.
ENCRYPTION_KEY=
# Protects /api/cron/tick — `openssl rand -hex 32`. Sent as `Authorization: Bearer <secret>`.
# Vercel Cron invocations are also accepted via the `x-vercel-cron` header.
CRON_SECRET=

# --- chains ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org
# optional, raises Jupiter rate limits https://portal.jup.ag
JUPITER_API_KEY=

# --- x402 data ---
# 1 = never pay. Data sources return their fixtures and `x402_payments` rows are written
# with `simulated: true` at the registry price, so budgets and the UI behave identically.
# Also forced per-call when an agent has no real (non-`paper_`) wallet for the network.
X402_MOCK=1

# --- agent runtime ---
# 1 = replace the LLM with a deterministic scripted model (get_portfolio →
# query_data_source(sentimentalpha) → place_trade $50 BONK → finish). No API key needed.
# This is what `pnpm demo` uses; leave it unset in normal dev.
LLM_MOCK=0

# --- app ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
