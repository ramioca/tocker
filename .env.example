# --- database ---
# Postgres (docker compose up -d) or embedded PGlite for zero-infra dev.
#   postgres://postgres:postgres@localhost:5433/vibe
#   pglite://./.pglite
DATABASE_URL=pglite://./.pglite

# --- privy (auth + wallets) https://dashboard.privy.io ---
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Authorization private key from Dashboard → Wallet infrastructure → Authorization keys.
# Paste it exactly as shown (the wallet-auth: prefix is fine). Agent server wallets are
# created with this key as their OWNER so the server can sign trades and x402 payments
# without a user session. Run `pnpm preflight` to prove the whole chain before funding.
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# Optional. The app's JWT verification key (SPKI public key) from the Privy dashboard,
# with or without the PEM header lines. When set, getSession() verifies access tokens
# locally instead of fetching the app's JWKS on every request.
PRIVY_VERIFICATION_KEY=
# Which ways of signing in the card and Privy's own modal offer. Comma-separated, from:
# email, google, twitter, passkey, wallet. Case and spaces are ignored and unknown names
# are dropped; unset, empty or nothing valid means "email,wallet". Email is always on,
# whatever is typed here: it is the one method every account can use. Keep it
# equal to what is switched on in the Privy dashboard, because a method listed here but
# off there fails the moment it is pressed, and read DEPLOY.md 2a-2 before adding
# twitter. Inlined at build time (NEXT_PUBLIC_), so a change needs a redeploy.
NEXT_PUBLIC_LOGIN_METHODS=email,wallet

# --- secrets ---
# 32 bytes base64 — `openssl rand -base64 32`. Encrypts user LLM keys at rest.
ENCRYPTION_KEY=
# Protects /api/cron/tick — `openssl rand -hex 32`
CRON_SECRET=

# --- chains ---
# Use a real provider (Helius: https://mainnet.helius-rpc.com/?api-key=...). The public RPC is
# rate-limited enough to fail a transfer. Server-only: the browser gets blockhashes from
# /api/solana/blockhash, so this key never ships to visitors.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org
# optional, raises Jupiter rate limits https://portal.jup.ag
JUPITER_API_KEY=

# --- x402 data ---
# 1 = never pay. Data sources return fixtures and x402_payments rows are written with
# simulated=true at the registry price. With it off, payments are signed by the PLATFORM
# wallet on the resource's network (created on first use, funded by you) — not by the
# agent, which needs wallets only to trade.
X402_MOCK=1

# --- the platform's own money ---
# What every executed fill is charged, in USD. 0 switches the fee off entirely.
# Accrued at fill time in `platform_fees`, swept from the agent's wallet to the platform
# wallet by the guardian once the agent owes the threshold below — never on the trade path.
PLATFORM_FEE_USD=0.10
# How much an agent has to owe before that sweep happens. Ten transfers of ten cents cost
# more than they collect.
PLATFORM_FEE_SETTLE_MIN_USD=1.00

# --- admin ---
# Who may open Settings → Admin: comma-separated emails, trimmed, case-insensitive,
# matched against the address on the user's row. Blank or unset means NOBODY — there is
# no bootstrap admin, and /settings/admin 404s for everyone until this is set. The
# address has to be one Privy linked at signup; a wallet-only account has no email.
ADMIN_EMAILS=

# --- token data ---
# 1 = discovery and scoring read local fixtures, no network. Leave unset to score real,
# live Solana and Base launches: Jupiter, DexScreener, GoPlus and RugCheck are all free
# and need no key. Tests and `pnpm demo` force it on.
TOKENS_MOCK=

# --- app ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- web push (mobile approve/reject) ---
# Proposals can expire in five minutes, so the owner has to be reachable with every tab
# closed. Generate ONE key pair and keep it forever — rotating it invalidates every
# device already subscribed, and they only re-register when someone next taps "Enable
# alerts". With any of the three server variables unset, push degrades silently: no
# subscribe, no send, no error; the in-tab Notification still fires.
#
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# The public key goes in TWICE, deliberately: the server signs with it, and the browser
# has to pass the same bytes to pushManager.subscribe(), which means it must be
# NEXT_PUBLIC_. It is a public key; there is nothing to leak.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# How a push service reaches a human when this app misbehaves. mailto: (or an https:
# contact URL). Anything else is treated as unconfigured.
VAPID_SUBJECT=mailto:ops@tocker.xyz
#
# One-tap Approve/Reject links are signed with a key derived from ENCRYPTION_KEY above,
# so that variable is required for push to do anything useful. iOS delivers push ONLY
# to a web app installed to the home screen (Share → Add to Home Screen); Android and
# desktop deliver to the browser directly.

# --- local dev only ---
# Dev backdoor: getSession() returns this user with no auth at all. Active ONLY when
# NODE_ENV !== "production" AND Privy is not configured (no NEXT_PUBLIC_PRIVY_APP_ID /
# PRIVY_APP_SECRET). Use it with the seeded demo user:
#   pnpm db:seed && DEV_IMPERSONATE_USER_ID=did:privy:seed-you pnpm dev
DEV_IMPERSONATE_USER_ID=

# --- agent runtime ---
# 1 = replace the LLM with a deterministic scripted model (get_portfolio →
# query_data_source(sentimentalpha) → place_trade $50 BONK → finish). No API key needed.
# This is what `pnpm demo` uses; leave it unset in normal dev.
LLM_MOCK=0
