{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/cron/tick/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/marks/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/inference/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/agents/[id]/run/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/marks",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/tick",
      "schedule": "2-59/5 * * * *"
    },
    {
      "path": "/api/cron/inference",
      "schedule": "1-59/5 * * * *"
    }
  ]
}
